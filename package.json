{
  "name": "@fastify/boileplate",
  "version": "2.43.0",
  "private": true,
  "description": "Fastify boilerplate",
  "license": "UNLICENSED",
  "author": {
    "name": "Marco Asta",
    "email": "marcoasta55@gmail.com"
  },
  "type": "module",
  "main": "dist/server.js",
  "types": "types/fastify.d.ts",
  "scripts": {
    "build": "cross-env NODE_ENV=production tsup",
    "clean": "rimraf dist",
    "coverage": "cross-env NODE_ENV=test vitest  --coverage ",
    "debug": "cross-env NODE_ENV=development tsx watch ./src/server.ts --inspect",
    "dev": "cross-env NODE_ENV=development tsx watch ./src/server.ts",
    "docker:build": "docker build -f Dockerfile -t authservice-api .",
    "docker:build-nocache": "docker build --progress=plain --no-cache -f Dockerfile -t authservice-api .",
    "format": "prettier \"**/src/**/*.{js,json,ts,css,scss,vue,html,md}\" --write",
    "lic": "pnpm lic:json && pnpm lic:md",
    "lic:json": "npx license-checker-rseidelsohn --json --production --excludePrivatePackages --out ./src/licenses/licenses.json",
    "lic:md": "npx license-checker-rseidelsohn --markdown --production --excludePrivatePackages --out ./src/licenses/licenses.md",
    "lint": "eslint --cache --cache-location ./eslint-cache --no-error-on-unmatched-pattern \"src/**/*.{ts,vue}\" --fix -o eslint-report.html -f html",
    "preview": "pnpm build && pnpm serve",
    "serve": "cross-env NODE_ENV=production tsx ./dist/server.js",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:config": "cross-env NODE_ENV=test vitest configService",
    "test:ui": "cross-env NODE_ENV=test vitest --ui",
    "test:unit": "cross-env NODE_ENV=test vitest --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.1",
    "@fastify/mongodb": "^9.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/one-line-logger": "^2.0.1",
    "@fastify/postgres": "^6.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "5.2.2",
    "@paralect/node-mongo": "^3.2.0",
    "@types/fs-extra": "^11.0.4",
    "axios": "^1.18.1",
    "cli-color": "^2.0.4",
    "close-with-grace": "2.1.0",
    "cross-env": "10.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "detect-port": "^2.1.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "0.45.1",
    "drizzle-query-helper": "^1.4.0",
    "drizzle-zod": "0.8.3",
    "esm": "^3.2.25",
    "fastify": "^5.9.0",
    "fastify-favicon": "^5.0.0",
    "fastify-guard": "^3.0.0",
    "fastify-multer": "^2.0.3",
    "fastify-plugin": "^6.0.0",
    "fastify-qs": "^5.0.0",
    "fastify-rabbitmq": "^3.4.0",
    "fastify-zod": "^1.4.0",
    "fastify-zod-openapi": "^5.6.1",
    "figlet": "^1.11.0",
    "form-data": "^4.0.1",
    "fs-extra": "^11.3.6",
    "guid-typescript": "^1.0.9",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "meilisearch": "^0.55.0",
    "node-dependency-injection": "^3.2.2",
    "path": "^0.12.7",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-loki": "^2.4.0",
    "pino-opentelemetry-transport": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "qs": "^6.15.3",
    "rss-parser": "^3.13.0",
    "statuses": "^2.0.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "zod": "^4.3.6",
    "zod-openapi": "^5.4.6",
    "zod-to-json-schema": "^3.24.1",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@types/cli-color": "^2.0.6",
    "@types/figlet": "^1.7.0",
    "@types/http-errors": "^2.0.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/qs": "^6.15.1",
    "@types/statuses": "^2.0.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-istanbul": "^2.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^2.1.8",
    "eslint": "9.26.0",
    "http-errors": "^2.0.0",
    "mime-types": "^2.1.35",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "syncpack": "^13.0.4",
    "testcontainers": "^12.0.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}